# Pusaka runs with NO variables set: the web app, `npm run demo`, `node scripts/verify.mjs` and the
# read-only MCP server all work on testnet out of the box. Set these only for the parts named.

# ---- network (everything) ----
# testnet (default) or mainnet. Node reads PUSAKA_NETWORK, the Vite build reads VITE_NETWORK.
PUSAKA_NETWORK=testnet
VITE_NETWORK=testnet
# Override the contract account (mainnet has none yet; see docs/MAINNET.md).
# PUSAKA_CONTRACT=pusaka-btc.testnet

# ---- relayer: api/relay, api/prove, api/holder (Vercel env) ----
# A NEAR account that pays gas for gas-free proofs/check-ins. Create one with
# `near account create-account sponsor-by-faucet-service <name>.testnet`, then add a gas key:
# `node scripts/gas-key.mjs setup` (see README "relayer signs with a gas key").
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Key for the holder room's sealed letters; defaults to RELAYER_PRIVATE_KEY. Any long random string.
LETTER_SECRET=

# ---- MCP server (mcp/server.mjs) for an AI agent that acts ----
# Without these the server is read-only. The key is the agent's own NEAR account key (never a person's).
PUSAKA_ACCOUNT_ID=
PUSAKA_PRIVATE_KEY=
# Hard cap on NEAR spent per session (default 5).
PUSAKA_MAX_SPEND_NEAR=5
# Withdrawals and gifts stay off unless set to 1; optionally limit where they may go.
PUSAKA_ALLOW_OUTFLOWS=
PUSAKA_ALLOWED_RECIPIENTS=
# "off" skips the MCP elicitation (human yes) before spending; leave empty.
PUSAKA_CONFIRM=

# ---- optional ----
# market.near.ai agent token (aat_…) for mcp/market-worker.mjs; from your market.near.ai account.
AGENT_MARKET_TOKEN=
# Point e2e tests / scripts at another deployment.
# E2E_URL=http://localhost:4173
# PUSAKA_APP=https://pusaka-two.vercel.app
# HOLDER_API=https://pusaka-two.vercel.app

# ---- Shade Agent (shade/): its own shade/.env (AGENT_CONTRACT_ID, Phala key), see README "Deposit prover in a TEE" ----
